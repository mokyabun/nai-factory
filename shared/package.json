{
    "name": "@nai-factory/shared",
    "version": "0.3.0",
    "module": "src/index.ts",
    "types": "src/index.ts",
    "type": "module",
    "scripts": {
        "test": "bun test",
        "check:type": "tsc --noEmit",
        "check": "bun run --parallel --no-exit-on-error format:check lint typecheck",
        "check:fix": "bun run lint:fix && bun run format && bun run typecheck",
        "format": "oxfmt .",
        "format:fix": "bun run format",
        "lint": "oxlint .",
        "lint:fix": "oxlint --fix .",
        "typecheck": "bun run check:type",
        "format:check": "oxfmt --check ."
    },
    "dependencies": {
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@tsconfig/bun": "^1.0.10",
        "@types/bun": "^1.3.14"
    }
}
