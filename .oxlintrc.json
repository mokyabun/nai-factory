{
    "$schema": "./node_modules/oxlint/configuration_schema.json",
    "plugins": [
        "eslint",
        "typescript",
        "unicorn",
        "oxc",
        "import",
        "react",
        "react-perf",
        "jsx-a11y",
        "promise",
        "node"
    ],
    "categories": {
        "correctness": "error"
    },
    "rules": {
        "import/no-unassigned-import": "off",
        "react/react-in-jsx-scope": "off"
    },
    "options": {
        "typeAware": true,
        "typeCheck": true,
        "denyWarnings": true,
        "reportUnusedDisableDirectives": "error"
    },
    "ignorePatterns": [
        "**/node_modules/**",
        "**/dist/**",
        "**/coverage/**",
        "web/src/routeTree.gen.ts",
        "web/src/components/ui/**",
        "server/src/db/migrations/**",
        "server/assets/**",
        "web/src/styles.css"
    ],
    "overrides": [
        {
            "files": [
                "web/src/features/project-tree/create-project-dialog.tsx",
                "web/src/features/project-tree/create-group-dialog.tsx",
                "web/src/features/project/create-scene-dialog.tsx",
                "web/src/features/import/sd-studio-import-dialog.tsx",
                "web/src/features/project-tree/rename-input.tsx"
            ],
            "rules": {
                "jsx-a11y/no-autofocus": "off"
            }
        }
    ]
}
