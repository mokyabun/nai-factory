{
    "name": "@nai-factory/server",
    "version": "1.0.0",
    "module": "src/index.ts",
    "scripts": {
        "dev": "bun run --hot src/index.ts",
        "build": "bun run build:tag-index && bun build src/index.ts --outdir=dist --target=bun --minify --sourcemap && bun run build:migrations",
        "build:prod": "rm -rf dist && bun run build:tag-index && bun build src/index.ts --outdir=dist --target=bun --minify --sourcemap=none && bun run build:migrations",
        "build:tag-index": "bun run scripts/build-tag-search-index.ts",
        "start": "bun dist/index.js",
        "test": "NODE_ENV=test bun test",
        "check:type": "tsc --noEmit",
        "db:generate": "drizzle-kit generate",
        "check": "bun run --parallel --no-exit-on-error format:check lint typecheck",
        "check:fix": "bun run lint:fix && bun run format && bun run typecheck",
        "format": "oxfmt .",
        "format:fix": "bun run format",
        "lint": "oxlint .",
        "lint:fix": "oxlint --fix .",
        "typecheck": "bun run check:type",
        "format:check": "oxfmt --check .",
        "build:migrations": "rm -rf dist/migrations && cp -R src/db/migrations dist/migrations",
        "db:check": "drizzle-kit check"
    },
    "dependencies": {
        "@nai-factory/shared": "workspace:*",
        "drizzle-orm": "^0.45.2",
        "fflate": "^0.8.3",
        "flexsearch": "^0.8.212",
        "fractional-indexing-jittered": "^1.0.0",
        "handlebars": "^4.7.9",
        "hono": "^4.12.21",
        "pino": "^10.3.1",
        "sharp": "^0.34.5",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@tsconfig/bun": "^1.0.10",
        "@types/bun": "^1.3.14",
        "@types/flexsearch": "^0.7.42",
        "@types/node": "^25.9.1",
        "drizzle-kit": "^0.31.10",
        "pino-pretty": "^13.1.3"
    }
}
